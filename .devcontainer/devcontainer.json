// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
    "name": "Tijhuis Website",
    // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
    "workspaceFolder": "/workspace",
    "runArgs": [
        "--init",
        "--env-file",
        ".devcontainer/devcontainer.secrets.env",
        // Make other docker containers available through host.docker.internal special DNS name
        "--add-host=host.docker.internal:host-gateway"
    ],
    // "overrideCommand": false,
    "mounts": [
        "source=/var/run/docker.sock,target=/var/run/docker-host.sock,type=bind"
    ],
    // Features to add to the dev container. More info: https://containers.dev/features.
    // "features": {},
    "features": {
        "ghcr.io/devcontainers/features/common-utils": {
            "installZsh": true,
            "installOhMyZsh": true,
            "installOhMyZshConfig": true,
            "configureZshAsDefaultShell": true
        },
        "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
            "plugins": "zsh-autosuggestions zsh-syntax-highlighting",
            "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-syntax-highlighting.git"
        }
    },
    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    // "forwardPorts": [],
    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-vscode.vscode-node-azure-pack",
                "ms-azuretools.vscode-docker",
                "christian-kohler.path-intellisense",
                "VisualStudioExptTeam.vscodeintellicode",
                "njpwerner.autodocstring",
                "tamasfe.even-better-toml",
                "fill-labs.dependi",
                "redhat.vscode-yaml"
            ]
        }
    },
    // Use 'postCreateCommand' to run commands after the container is created.
    // if this does not work, then execute the lines manually or
    // rename file postCreateCommand and copy content to new file "postCreateCommand.sh",
    // rebuild devcontainer and delete copied file
    "postCreateCommand": "bash .devcontainer/postCreateCommand.sh",
    // Configure tool-specific properties.
    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    // "remoteUser": "root",
    "containerEnv": {
        "DOCKER_HOST": "unix:///var/run/docker-host.sock"
    },
    "remoteEnv": {
        "UV_LINK_MODE": "copy"
    }
}